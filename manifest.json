{
  "manifest_version": 3,
  "name": "外链机会助手 · Backlink Finder",
  "version": "2.0.0",
  "description": "发现博客评论外链机会，按任务队列拟真填充并跟踪发布结果。侧边栏常驻，收集 / 发布 / 日志 / 资源库四个工作区。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "scripting", "sidePanel", "webNavigation"],
  "host_permissions": ["https://api.goanyapi.com/*"],
  "optional_host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "外链机会助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
